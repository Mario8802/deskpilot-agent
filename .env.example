# Ollama runs locally by default.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Safety default: 0 means dry-run only.
DESKPILOT_EXECUTE=0

# Comma-separated logical app names allowed for launch_app.
# Windows defaults are implemented for notepad and calculator.
DESKPILOT_ALLOWED_APPS=notepad,calculator

# Optional database path.
DESKPILOT_DB=deskpilot.db
